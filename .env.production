# Build-time values for production bundles.
#
# None of this is secret: the API URL is visible in every browser network tab
# and the Cognito app client is a public client with no secret. They are
# committed because a clean CI checkout has no .env.local, and the Deploy
# workflow builds from one. Without this file the bundle calls the Amplify
# origin instead of the API and cannot reach Cognito — that regression shipped
# once, which is why deploy.yml now asserts both values inside the built file.
#
# Keep in step with terraform/ when the pool or the API is recreated.
VITE_API_BASE_URL="https://7h7i5bb7o3.execute-api.us-east-1.amazonaws.com/dev"
VITE_COGNITO_REGION="us-east-1"
VITE_COGNITO_CLIENT_ID="34pb90k0dsp7oi19bb4qltstc9"
VITE_COGNITO_DOMAIN="cs2-unboxed-dev-e3f18ac3.auth.us-east-1.amazoncognito.com"
