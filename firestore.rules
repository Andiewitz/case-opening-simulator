rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      let isEmailValid = data.email is string && data.email.size() <= 256;
      let isBalanceValid = data.balance is number;
      let isStatsValid = data.stats is map 
                         && data.stats.keys().hasAll(['casesOpened', 'totalSpent', 'totalValue'])
                         && data.stats.casesOpened is number
                         && data.stats.totalSpent is number
                         && data.stats.totalValue is number;
      
      return data.keys().size() == 5 
             && data.keys().hasAll(['email', 'balance', 'stats', 'createdAt', 'updatedAt'])
             && isEmailValid 
             && isBalanceValid 
             && isStatsValid
             && data.createdAt is timestamp 
             && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
                    && isOwner(userId) 
                    && isValidUser(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time
                    && incoming().balance >= 0;
                    
      allow update: if isOwner(userId) 
                    && isValidUser(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && incoming().email == existing().email
                    // Action: Update Balance and Stats
                    && incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'stats', 'updatedAt']);
    }

    function isValidInventoryItem(data, userId) {
      let isUserIdValid = data.userId == userId;
      let isNameValid = data.name is string && data.name.size() > 0 && data.name.size() <= 100;
      let isRarityValid = data.rarity is string && data.rarity.size() <= 50;
      let isColorValid = data.color is string && data.color.size() <= 10;
      let isImageValid = data.image is string && data.image.size() <= 1000;
      let isPriceValid = data.price is number;
      let isConditionValid = data.condition is string && data.condition.size() <= 30;
      let isStatTrakValid = data.isStatTrak is bool;
      
      return (data.keys().size() >= 9)
             && data.keys().hasAll(['userId', 'name', 'rarity', 'color', 'image', 'price', 'condition', 'isStatTrak', 'createdAt'])
             && isUserIdValid 
             && isNameValid 
             && isRarityValid
             && isColorValid
             && isImageValid
             && isPriceValid
             && isConditionValid
             && isStatTrakValid
             && data.createdAt is timestamp;
    }

    match /users/{userId}/inventory/{itemId} {
      // Must check that parent exists? Not strictly necessary if userId is authenticated and matching.
      allow get: if isOwner(userId);
      allow list: if isOwner(userId) && resource.data.userId == userId;
      
      // Action: Add Item (Only add item via case opening)
      allow create: if isValidId(userId)
                    && isValidId(itemId)
                    && isOwner(userId)
                    && isValidInventoryItem(incoming(), userId)
                    && incoming().createdAt == request.time
                    && existsAfter(/databases/$(database)/documents/users/$(userId)); 
                    // Ensures atomicity when buying case / adding item
                    
      // Action: Sell Item
      allow delete: if isOwner(userId) 
                    && existing().userId == userId; 
                    // Normally deleting should also be atomic with user balance update, 
                    // which is driven by an existsAfter on the user doc or checked via batch context.
    }
  }
}
