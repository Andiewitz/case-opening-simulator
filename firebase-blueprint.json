{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the case opening application.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "balance": {
          "type": "number",
          "description": "The user's current virtual currency balance."
        },
        "stats": {
          "type": "object",
          "properties": {
            "casesOpened": { "type": "number" },
            "totalSpent": { "type": "number" },
            "totalValue": { "type": "number" }
          }
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["email", "balance", "stats", "createdAt", "updatedAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "An item obtained from a case, owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user who owns the item."
        },
        "name": {
          "type": "string"
        },
        "rarity": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "condition": {
          "type": "string"
        },
        "isStatTrak": {
          "type": "boolean"
        },
        "pattern": {
          "type": "number",
          "description": "Skin paint seed pattern index (1-1000)"
        },
        "float": {
          "type": "number",
          "description": "Wear float value (0.0 - 1.0)"
        },
        "phase": {
          "type": "string",
          "description": "Phase of the knife (e.g., Phase 1, Emerald)"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["userId", "name", "rarity", "color", "image", "price", "condition", "isStatTrak", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles including their balance."
    },
    "users/{userId}/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Stores individual case drops for a specific user."
    }
  }
}
