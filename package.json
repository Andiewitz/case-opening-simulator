{
  "name": "cs2-unboxed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "setup": "npm ci",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "bake-crates": "tsx scripts/bake-crates.ts",
    "check:crates": "tsx scripts/check-crates-snapshot.ts",
    "build:backend": "./scripts/build-backend.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p backend/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.14.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@eslint/js": "^9.18.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.1.0"
  }
}
