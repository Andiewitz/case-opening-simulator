# Frontend (Vite) — every variable here is read by src/, nothing else.
# Copy to .env for local development. Vite only exposes VITE_* to the browser.

# Cognito user pool app client (safe to expose: it is a public client).
# The region and domain are only used for the refresh-token grant.
VITE_COGNITO_REGION="us-east-1"
VITE_COGNITO_DOMAIN="MY_COGNITO_DOMAIN.auth.<region>.amazoncognito.com"
VITE_COGNITO_CLIENT_ID="MY_COGNITO_CLIENT_ID"

# API Gateway base URL, e.g. https://<id>.execute-api.us-east-1.amazonaws.com/dev
# Leave empty to run the UI without a backend (it will show its error state).
VITE_API_BASE_URL=""
